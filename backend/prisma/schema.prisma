// Unified schema — Peter's Signal feed (base) + thit's Trust/Reputation layer.
// Trust score & reputation are calculated from Peter's verifiedCount/unverifiedCount.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  password        String
  role            UserRole @default(USER)
  reputationScore Int      @default(0)
  sector          Int      @default(1)

  signals       Signal[]
  verifications Verification[]

  // vivi: trade + vault relations
  trades         Trade[]
  acceptedTrades Trade[]     @relation("TradeAcceptor")
  vaultItems     VaultItem[]

  createdAt DateTime @default(now())
}

model Signal {
  id         String @id @default(cuid())
  authorName String // Peter: callsign shown on the feed

  // Optional link to an authenticated author (thit: reputation lives on the User)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  content String
  sector  Int

  // Peter's fields
  priority  String    @default("STANDARD")
  deletedAt DateTime?

  // thit's optional classification fields
  title       String?
  category    SignalCategory?
  dangerLevel DangerLevel?

  // Trust/verification — Peter's counts; thit calculates trust & reputation from these
  trustScore      Float @default(50)
  verifiedCount   Int   @default(0)
  unverifiedCount Int   @default(0)

  // thit's moderation
  flagged    Boolean @default(false)
  flagReason String?

  comments      Comment[]
  verifications Verification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id         String   @id @default(cuid())
  signalId   String
  signal     Signal   @relation(fields: [signalId], references: [id])
  authorName String
  content    String
  createdAt  DateTime @default(now())
}

model Verification {
  id String @id @default(cuid())

  signalId String
  signal   Signal @relation(fields: [signalId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status VerificationStatus

  createdAt DateTime @default(now())

  @@unique([signalId, userId])
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  VERIFIED
  SUSPICIOUS
  OUTDATED
}

enum SignalCategory {
  SHELTER
  DANGER
  SUPPLIES
  EVACUATION
  MEDICAL
}

enum DangerLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ===== vivi: Trade + Vault (barter marketplace) =====

model Trade {
  id String @id @default(uuid())

  resourceName String
  quantity     Int
  condition    ItemCondition

  requestedItem     String
  requestedQuantity Int

  traderName String
  category   ResourceCategory
  location   String?

  status TradeStatus @default(ACTIVE)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  vaultItemId String?
  vaultItem   VaultItem? @relation(fields: [vaultItemId], references: [id], onDelete: SetNull)

  acceptorId String?
  acceptor   User?   @relation("TradeAcceptor", fields: [acceptorId], references: [id])

  acceptorVaultItemId String?
  acceptorVaultItem   VaultItem? @relation("TradeAcceptor", fields: [acceptorVaultItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VaultItem {
  id String @id @default(cuid())

  resourceName String
  quantity     Int
  condition    ItemCondition
  category     ResourceCategory
  acquiredDate DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trades         Trade[]
  acceptorTrades Trade[]  @relation("TradeAcceptor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum ItemCondition {
  PRISTINE
  GOOD
  WORN
  DAMAGED
}

enum TradeStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ResourceCategory {
  MEDICINE
  FOOD
  FUEL
  BATTERIES
  TOOLS
  PARTS
  AMMO
}

enum RarityLevel {
  COMMON
  UNCOMMON
  RARE
  CRITICAL
}
