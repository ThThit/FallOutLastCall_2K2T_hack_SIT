// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String               @id @default(cuid())
  username        String               @unique
  password        String

  reputationScore Int                  @default(0)

  signals         Signal[]
  verifications   SignalVerification[]

  createdAt       DateTime             @default(now())
}

model Signal {
  id               String                @id @default(cuid())

  title            String
  message          String
  category         SignalCategory
  dangerLevel      DangerLevel

  userId           String
  user             User                  @relation(fields: [userId], references: [id])

  verifications    SignalVerification[]

  trustScore       Float                 @default(0)
  verificationRate Float                 @default(0)

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model SignalVerification {
  id          String             @id @default(cuid())

  signalId    String
  signal      Signal             @relation(fields: [signalId], references: [id])

  userId      String
  user        User               @relation(fields: [userId], references: [id])

  status      VerificationStatus

  createdAt   DateTime           @default(now())

  @@unique([signalId, userId])
}

model MemoryArchive {
  id              String   @id @default(uuid())
  title           String
  survivorAlias   String   @default("Anonymous")

  category        String
  content         String
  emotionalTag    String

  date            DateTime @default(now())

  decayLevel      Int      @default(0)
  isRestored      Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum VerificationStatus {
  VERIFIED
  SUSPICIOUS
  OUTDATED
}

enum SignalCategory {
  SHELTER
  DANGER
  SUPPLIES
  EVACUATION
  MEDICAL
}

enum DangerLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}