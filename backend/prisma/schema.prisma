generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  password        String
  reputationScore Int      @default(0)
  createdAt       DateTime @default(now())
}

model Signal {
  id              String    @id @default(cuid())
  authorName      String
  content         String
  sector          Int
  priority        String    @default("STANDARD")
  trustScore      Float     @default(50)
  verifiedCount   Int       @default(0)
  unverifiedCount Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  comments        Comment[]
}

model Comment {
  id         String   @id @default(cuid())
  signalId   String
  signal     Signal   @relation(fields: [signalId], references: [id])
  authorName String
  content    String
  createdAt  DateTime @default(now())
}
